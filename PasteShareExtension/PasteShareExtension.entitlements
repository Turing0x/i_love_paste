<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Solo el grupo: la extensión escribe en la base compartida y termina.
	     Nada de CloudKit ni push — la app es quien sincroniza. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.threedots.paste</string>
	</array>
</dict>
</plist>

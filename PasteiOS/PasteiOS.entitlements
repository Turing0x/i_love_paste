<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Contenedor compartido con las extensiones: es la única forma de que la
	     Share Extension escriba en el mismo historial que lee la app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.threedots.paste</string>
	</array>

	<!-- El mismo contenedor de iCloud que el Mac. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.threedots.paste</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
